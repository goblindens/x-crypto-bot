# --- Threads (Meta) -- plataforma padrao, API gratuita -----------------------
# developers.facebook.com -> seu app -> Threads -> Settings -> User Token Generator
THREADS_ACCESS_TOKEN=
# Opcional: o bot descobre sozinho pelo token. So preencha se quiser fixar.
THREADS_USER_ID=

# --- X (opcional, PAGO por post) --------------------------------------------
# Credenciais do X (developer.x.com -> Projects & Apps -> Keys and tokens)
# O App precisa de permissao "Read and write" e User authentication (OAuth 1.0a) ativa.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Opcional: sem ela o bot usa template fixo em vez de texto escrito pela Claude
ANTHROPIC_API_KEY=
